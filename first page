:root {
  --brown: #5f4434;
  --dark: #3b2a22;
  --pink: #ffbab3;
  --light-pink: #f5cbd6;
  --cream: #f8f6e9;

  --heading-font: "Ibarra Real Nova", serif;
  --body-font: "Raleway", sans-serif;
}

* {
  margin: 0;
  padding: 0;
  box-sizing: border-box;
}

body {
  background-color: #f8f4e6;
  color: #3b2a22;
  font-family: "Raleway", sans-serif;
}

.content {
  padding: 25px 40px 50px;
}

a {
  color: #3b2a22;
  text-decoration: none;
}

.path {
  font-size: 12px;
  margin-bottom: 20px;
}

.wrapper {
  display: flex;
  gap: 50px;
  max-width: 1100px;
  margin: 0 auto;
}

/* left side */
.left {
  width: 55%;
}

.big-box {
  position: relative;
  background-color: #5c4033;
  color: #f8f4e6;
  text-align: center;
  padding: 25px 20px;
  border: 1px solid #3b2a22;
  border-radius: 10px;
}

.small-text {
  font-size: 10px;
}

.color-name {
  font-family: "Ibarra Real Nova", serif;
  font-style: italic;
  font-size: 18px;
}

.small-pics {
  position: absolute;
  top: 55px;
  left: 10px;
}

.small-pics img {
  display: block;
  width: 35px;
  height: 35px;
  margin-bottom: 8px;
  background-color: #f8f4e6;
  border-radius: 3px;
  object-fit: cover;
}

.shirts {
  display: flex;
  margin-top: 10px;
  padding-left: 40px;
}

.shirts div {
  width: 50%;
}

.shirts img {
  width: 100%;
}

.shirts p {
  font-size: 10px;
  margin-top: 8px;
}

.other-colors {
  display: flex;
  gap: 14px;
  margin-top: 14px;
}

.box {
  width: 50%;
  padding: 12px;
  border: 1px solid #3b2a22;
  border-radius: 10px;
}

.box img {
  width: 100%;
}

.pink {
  background-color: #fde0d6;
}

.yellow {
  background-color: #f9f6df;
}

/* right side */
.right {
  width: 45%;
}

.right h1 {
  font-family: "Ibarra Real Nova", serif;
  font-size: 34px;
}

.right h2 {
  font-family: "Ibarra Real Nova", serif;
  font-size: 26px;
  font-weight: 500;
  margin: 8px 0 16px;
}

.right p {
  font-size: 14px;
  margin-bottom: 12px;
}

.right h3 {
  font-size: 14px;
  margin: 18px 0 8px;
}

input[type="radio"] {
  display: none;
}

/* color circles */
.colors {
  display: flex;
  gap: 12px;
}

.dot {
  width: 24px;
  height: 24px;
  border: 1px solid #3b2a22;
  border-radius: 50%;
  cursor: pointer;
}

.white { background-color: #ffffff; }
.brown { background-color: #5c4033; }
.black { background-color: #000000; }

.colors input:checked + .dot {
  outline: 2px solid #3b2a22;
  outline-offset: 2px;
}

/* sizes */
.sizes {
  display: flex;
  flex-wrap: wrap;
  gap: 8px;
}

.sizes label {
  padding: 3px 9px;
  font-size: 12px;
  border: 1px solid #3b2a22;
  border-radius: 4px;
  cursor: pointer;
}

.sizes input:checked + label {
  background-color: #3b2a22;
  color: #f8f4e6;
}

/* quantity */
.quantity {
  display: flex;
  justify-content: space-between;
  align-items: center;
  width: 95px;
  padding: 4px 10px;
  border: 1px solid #3b2a22;
  border-radius: 4px;
}

.quantity button {
  background: none;
  border: none;
  font-size: 18px;
  cursor: pointer;
}

.quantity span {
  font-size: 12px;
}

/* buttons */
.buttons {
  display: flex;
  gap: 14px;
  margin-top: 20px;
}

.buttons button {
  width: 50%;
  padding: 11px;
  font-family: "Raleway", sans-serif;
  font-size: 12px;
  font-weight: 700;
  border: 1px solid #3b2a22;
  border-radius: 5px;
  cursor: pointer;
}

.order {
  background-color: transparent;
  color: #3b2a22;
}

.cart {
  background-color: #3b2a22;
  color: #f8f4e6;
}

/* ---------- Footer ---------- */
.product-footer {
  background-color: var(--light-pink);
  padding: 30px 90px;
}

.product-footer-main {
  display: flex;
  justify-content: space-between;
  gap: 40px;
}

.product-footer-brand {
  max-width: 460px;
}

.product-footer-logo {
  font-family: var(--heading-font);
  font-size: 5.5rem;
  line-height: 1.1;
  color: var(--brown);
}

.product-footer-text {
  font-size: 0.85rem;
  margin-top: 25px;
}

.product-footer-column {
  display: flex;
  flex-direction: column;
  gap: 4px;
  padding-top: 10px;
}

.product-footer-column h4 {
  font-family: var(--heading-font);
  font-size: 0.8rem;
  margin-bottom: 6px;
}

.product-footer-column a {
  font-size: 0.8rem;
}

.product-footer-column a:hover {
  color: var(--cream);
}

.product-socials {
  display: grid;
  grid-template-columns: repeat(3, 32px);
  gap: 14px 20px;
}

.icon-placeholder {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 32px;
  height: 32px;
  border: 1px solid var(--dark);
  border-radius: 50%;
}

.product-copyright {
  background-color: var(--dark);
  color: var(--cream);
  text-align: center;
  padding: 35px 20px;
  font-size: 0.9rem;
}

.product-copyright a {
  color: var(--cream);
}

/* phone view */
@media (max-width: 800px) {
  .wrapper {
    flex-direction: column;
  }
  .left, .right {
    width: 100%;
  }
  .product-footer {
    padding: 30px 20px;
  }
  .product-footer-main {
    flex-direction: column;
  }
  .product-footer-logo {
    font-size: 3.5rem;
  }
}
